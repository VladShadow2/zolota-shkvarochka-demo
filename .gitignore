# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — keep the example, ignore real values
.env
.env.*
!.env.example

# vercel
.vercel

# editor and OS leftovers
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts
